# Must match apps/api/.env's DATABASE_URL exactly - same database, same
# Neon branch. Mismatched branches here vs. the API is a real, easy-to-hit
# bug (see docs/BUILD_LOG.md, dev/prod isolation section).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=verify-full

# Must match apps/api/.env's REDIS_URL exactly - same Redis instance.
# Isolation between environments comes from the bull/bull-dev key prefix
# (derived automatically from NODE_ENV below), not from separate instances.
REDIS_URL=rediss://default:password@host:port

# Get from resend.com. Sandbox-restricted to a verified testing address
# until a custom sending domain is verified - see README.md.
RESEND_API_KEY=

# Leave unset locally. This worker also runs a bare HTTP health-check
# server (see apps/worker/src/health.ts) - locally it falls back to 4001.
# Do NOT set this to the same value as apps/api's port.
# PORT=4001

# Leave unset locally (defaults to 'development'). See apps/api/.env.example
# for what this controls.
# NODE_ENV=production
