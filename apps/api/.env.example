# Postgres connection string (Neon recommended - use the pooled host).
# sslmode=verify-full recommended over require/prefer for a stronger guarantee.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=verify-full

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use two DIFFERENT generated values - never reuse one secret for both.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Redis connection string (Upstash recommended).
REDIS_URL=rediss://default:password@host:port

# Local dev default is fine as-is. Only override to match your frontend's
# actual origin if you're not running it on localhost:3000.
CORS_ORIGIN=http://localhost:3000

# Leave unset locally (defaults to 4000). Render/hosting platforms inject
# their own PORT automatically - do not hardcode a value that conflicts.
# PORT=4000

# Leave unset locally (defaults to 'development'). Determines the BullMQ
# queue prefix (bull vs bull-dev) - see docs/DECISIONS.md for why this
# matters. Set explicitly to 'production' only on the real deployment.
# NODE_ENV=production
